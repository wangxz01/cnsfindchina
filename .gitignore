# --- 项目运行时产物（不入库，全部在 data/ 下；urls*.txt 除外，要入库） ---

# Playwright 持久化浏览器 profile（含 CF cookie 等敏感数据）
data/browser_profile/
data/browser_profile_nature/
data/browser_profile_science/

# 按文章 ID 缓存的抓取结果（可重生成）
data/cache/
data/cache_nature/
data/cache_science/

# 输出 Excel（按日期命名 / 用户自定义）
data/*.xlsx

# Excel 打开时生成的锁文件
~$*

# 日志
*.log
